# Sauvegarde Postgres — image dédiée pour l'architecture éclatée (voir DEPLOY-DOKPLOY.md).
# Le service `backup` de docker-compose.yml (mode tout-en-un) monte scripts/backup-postgres.sh
# en bind-mount ; ici, en Application Dokploy indépendante, le script est COPIÉ dans l'image
# au build — plus simple à déployer (pas de bind-mount à gérer côté Dokploy).
#
# CONTEXTE DE BUILD ATTENDU : la racine du repo (pas ce dossier infra/), pour copier
# scripts/backup-postgres.sh. Dans Dokploy : "Docker Context Path" = `.`,
# "Dockerfile Path" = `infra/Dockerfile.backup`.
FROM postgres:18-alpine
# apk (installation de rclone si R2_* est configuré) a besoin d'internet au démarrage —
# voir scripts/backup-postgres.sh. Alternative pour un réseau restreint : pré-installer ici
# avec `RUN apk add --no-cache rclone` pour ne plus en dépendre au runtime.
COPY scripts/backup-postgres.sh /backup.sh
RUN chmod +x /backup.sh
ENTRYPOINT ["sh", "/backup.sh"]
