# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Also used by the API server to build activation/reset links in notifications.
APP_URL="http://localhost:3000"

# --- BloomCore API (server/) ---
# Port HTTP de l'API (défaut 4000).
API_PORT=4000
# Secret de signature des tokens de session (HMAC). OBLIGATOIRE en production :
# min 16 caractères, aléatoire. En NODE_ENV=production, le serveur REFUSE de démarrer
# si ce secret est absent, trop court, ou laissé à une valeur d'exemple.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Chemin du fichier SQLite (backend LEGACY, encore utilisé tant que M6 n'est pas basculé).
# Vide = server/bloomcore.db ; ':memory:' pour les *.check.ts.
BLOOMCORE_DB=
# --- M6 : PostgreSQL (Prisma) ---
# URL de connexion Postgres. Sur Coolify : créer une ressource PostgreSQL dans le même
# projet et coller son URL interne ici. Format : postgresql://USER:PASS@HOST:5432/DB?schema=public
# Au boot, `prisma migrate deploy` applique le schéma, puis la migration one-shot
# blob(SQLite)→relationnel s'exécute une fois (gardée par un flag). Vide = backend SQLite legacy.
DATABASE_URL=
# Base URL de l'API vue par le frontend Vite. Utile SURTOUT en dev (Vite:3000 → API:4000).
# En prod mono-service (Dockerfile : l'API sert le frontend), laisser vide → chemin relatif
# same-origin `/api/v1` par défaut, valable quel que soit l'hôte de déploiement.
VITE_API_BASE=http://localhost:4000/api/v1
# Secret HMAC du webhook entrant École Bloom (POST /api/v1/webhooks/academy).
# Mêmes règles que AUTH_SECRET : obligatoire et fort en production.
ACADEMY_WEBHOOK_SECRET=
# Origines autorisées pour CORS, séparées par des virgules (S8). Vide en production = tout
# bloqué ; en dev, les ports Vite locaux sont acceptés par défaut.
CORS_ORIGINS=
# Mot de passe démo partagé pour le seed (S7). En production, laissé vide = aucun credential
# seedé, activation de compte obligatoire. Défini uniquement pour des démos/staging.
SEED_DEMO_PASSWORD=

# --- Canaux de notification réels (vides = adapters simulés, logs + outbox) ---
# Email (SMTP via nodemailer — `npm i nodemailer` pour activer l'envoi réel).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# Web Push (canal 'webpush' — `npm i web-push` déjà installé). Générer les clés :
#   npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY présent = canal push réel ; sinon simulé (log + outbox). Nécessite HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bloomcore.app

# --- Services d'infrastructure (docker-compose) ---
# Mot de passe du service Postgres embarqué du docker-compose (DATABASE_URL est câblé dessus).
POSTGRES_PASSWORD=
# Mot de passe du service Redis embarqué (REDIS_URL est câblé dessus). Consommé depuis la
# Phase 2 par server/rateLimit.ts (anti-brute-force partagé entre instances), server/auth.ts
# (cache de révocation pwd_version) et server/stream.ts (pub/sub SSE multi-instance/worker).
REDIS_PASSWORD=
# Port hôte du dashboard Uptime Kuma (monitoring de /api/v1/health).
KUMA_PORT=3001
# Nombre de jours de rétention des sauvegardes Postgres locales (service `backup`, voir
# docker-compose.yml + scripts/backup-postgres.sh). Défaut 14 jours si vide.
BACKUP_RETENTION_DAYS=14
# Copie hors-site des sauvegardes vers Cloudflare R2 (OPTIONNEL — vide = sauvegarde locale
# uniquement). Les 4 variables ci-dessous doivent TOUTES être renseignées pour activer la
# copie. Voir le commentaire du service `backup` dans docker-compose.yml pour la procédure
# de création du bucket/jeton R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Rétention des dumps sur R2 (jours). Plus longue que le local par défaut — le stockage R2
# est quasi gratuit jusqu'à 10 Go.
R2_RETENTION_DAYS=90

# --- Phase 5 : stockage objet MinIO/S3 pour les photos (OPTIONNEL, overlay) ---
# Tout vide = mode disque historique (/data/uploads), rien ne change. Pour activer :
#   docker compose -f docker-compose.yml -f docker-compose.minio.yml up -d --build
# puis définir les 3 variables ci-dessous (S3_ENDPOINT est ce qui déclenche le mode S3
# dans server/storage.ts). Migration des photos existantes : npx tsx server/migrate-uploads.ts.
S3_ENDPOINT=
# Identifiants MinIO (root user/password du service minio de l'overlay). S3_SECRET_KEY
# est OBLIGATOIRE si l'overlay minio est activé (le compose overlay refuse de démarrer sinon).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bloomcore

# --- Phase 6 : frontend séparé nginx (OPTIONNEL, overlay) ---
#   docker compose -f docker-compose.yml -f docker-compose.frontend.yml up -d --build
# Port hôte du frontend nginx ; VITE_API_BASE (plus haut) doit alors pointer sur le domaine
# de l'API, et CORS_ORIGINS (plus haut) inclure le domaine du frontend.
FRONTEND_PORT=8080

# RUN_SCHEDULER : géré directement dans docker-compose.yml (false sur l'API, le worker dédié
# s'en charge). Hors compose (dev local, mono-process), défaut = actif — rien à définir.

# --- Architecture éclatée Dokploy (OPTIONNEL — voir infra/DEPLOY-DOKPLOY.md) ---
# Uniquement utilisé par infra/Dockerfile.backup quand Postgres n'est PAS le service `db`
# du docker-compose.yml (mode tout-en-un) mais une ressource Database native Dokploy.
# Vide/absent = défauts alignés sur le mode tout-en-un (db/5432/postgres/bloomcore),
# rien ne change pour qui utilise docker-compose.yml normalement.
BACKUP_DB_HOST=
BACKUP_DB_PORT=
BACKUP_DB_USER=
BACKUP_DB_NAME=
